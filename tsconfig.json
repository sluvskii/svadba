{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Генерируемые .js-артефакты (.svelte-kit/output, cloudflare) попадают в программу
		// через import-цепочки и дают сотни ложных ошибок — проверять их не нужно.
		"checkJs": false,
		"types": [
			"$app/types",
			"./worker-configuration.d.ts"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["node_modules", ".svelte-kit", ".tools"]
}
